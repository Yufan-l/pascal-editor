FROM oven/bun:1.3.13

WORKDIR /app

ENV NODE_ENV=development \
    NEXT_TELEMETRY_DISABLED=1 \
    TURBO_TELEMETRY_DISABLED=1 \
    WATCHPACK_POLLING=true \
    PORT=3002

COPY package.json bun.lock ./
COPY apps/editor/package.json apps/editor/package.json
COPY apps/ifc-converter/package.json apps/ifc-converter/package.json
COPY packages/core/package.json packages/core/package.json
COPY packages/editor/package.json packages/editor/package.json
COPY packages/eslint-config/package.json packages/eslint-config/package.json
COPY packages/i18n/package.json packages/i18n/package.json
COPY packages/ifc-converter/package.json packages/ifc-converter/package.json
COPY packages/mcp/package.json packages/mcp/package.json
COPY packages/nodes/package.json packages/nodes/package.json
COPY packages/typescript-config/package.json packages/typescript-config/package.json
COPY packages/ui/package.json packages/ui/package.json
COPY packages/viewer/package.json packages/viewer/package.json
COPY tooling/typescript/package.json tooling/typescript/package.json
COPY apps/ifc-converter/scripts apps/ifc-converter/scripts

RUN bun install --frozen-lockfile

COPY . .
COPY docker/dev-entrypoint.sh /usr/local/bin/pascal-dev
RUN chmod 0755 /usr/local/bin/pascal-dev

EXPOSE 3002 3917

ENTRYPOINT ["pascal-dev"]
