# Optional environment variables — the editor works without any of these

# Google Maps API key (enables address search)
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Dev server port (default: 3002)
# PORT=3002

# MCP Streamable HTTP port (default: 3917)
# MCP_PORT=3917

# Development bearer token for http://localhost:3917/mcp
# PASCAL_MCP_HTTP_TOKEN=pascal-dev-token
