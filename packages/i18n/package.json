{
  "name": "@pascal-app/i18n",
  "version": "0.1.0",
  "description": "Lightweight UI localization runtime for Pascal",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --build",
    "check-types": "tsgo --noEmit",
    "test": "bun test src",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": "^18 || ^19"
  },
  "devDependencies": {
    "@pascal/typescript-config": "*",
    "@types/bun": "^1.3.0",
    "@types/react": "^19.2.2",
    "typescript": "6.0.3"
  },
  "keywords": [
    "i18n",
    "localization",
    "react"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/pascalorg/editor.git",
    "directory": "packages/i18n"
  },
  "license": "MIT"
}
